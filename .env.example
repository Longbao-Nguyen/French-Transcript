# App authentication (Google callback: /api/auth/callback/google)
AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APP_BASE_URL=http://localhost:3000

# Provider-neutral selection; only the postgres adapter is implemented initially.
DB_PROVIDER=postgres
DATABASE_URL=

# Private Vercel Blob store. The connected project authenticates with Vercel OIDC.
STORAGE_PROVIDER=vercel-blob
BLOB_STORE_ID=

# Optional; defaults to 2 GiB.
MAX_UPLOAD_BYTES=2147483648

# Optional: enables POST /api/ai/refine-french in server.ts.
GEMINI_API_KEY=

# Reserved by the legacy deployment documentation; current code does not read it.
APP_URL=http://localhost:3000
