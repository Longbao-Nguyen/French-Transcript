# App authentication (Google callback: /api/auth/callback/google)
AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APP_BASE_URL=http://localhost:3000

# Provider-neutral selection; only the postgres adapter is implemented initially.
DB_PROVIDER=postgres
DATABASE_URL=

# Private Cloudflare R2 bucket
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Optional override. Defaults to https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=

# Optional; defaults to 2 GiB.
MAX_UPLOAD_BYTES=2147483648

# Optional: enables POST /api/ai/refine-french in server.ts.
GEMINI_API_KEY=

# Reserved by the legacy deployment documentation; current code does not read it.
APP_URL=http://localhost:3000
